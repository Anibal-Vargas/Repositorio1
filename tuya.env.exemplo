# Copie este arquivo para "tuya.env" (mesma pasta do script) e preencha
# com as credenciais do seu projeto no console Tuya (iot.tuya.com).
# O tuya.env está no .gitignore e nunca deve ser commitado.
TUYA_ACCESS_ID=seu_access_id_aqui
TUYA_ACCESS_SECRET=seu_access_secret_aqui
TUYA_DEVICE_ID=seu_device_id_aqui
# Opcional: data center (padrão: Western America)
# TUYA_ENDPOINT=https://openapi.tuyaus.com
